# Copy to .env and fill in. .env is gitignored — never commit real values.

# --- Database ---
POSTGRES_DB=filinglens
POSTGRES_USER=filinglens
POSTGRES_PASSWORD=change-me

# --- SEC EDGAR ---
# SEC requires a declared User-Agent identifying you and a contact email.
# See https://www.sec.gov/os/accessing-edgar-data
SEC_USER_AGENT="FilingLens your-email@example.com"

# --- AI providers ---
# API key for answering questions and interpreting changes. Without it, Q&A is disabled.
# By default this is an Anthropic key (Claude).
LLM_API_KEY=
# LLM_MODEL=claude-opus-5-5
# Any service speaking the OpenAI Chat Completions API works instead; its key goes in
# LLM_API_KEY. Gemini has a free tier (key from https://aistudio.google.com/apikey; the
# models and limits it covers are listed at https://aistudio.google.com/rate-limit):
# LLM_PROVIDER=openai-compatible
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MODEL=gemini-3.8-flash
# Citations are then per block rather than exact quotes. A local Ollama works too, with
# LLM_BASE_URL=http://localhost:11434/v1/ and any non-empty LLM_API_KEY.
# Voyage AI key for semantic search. Without it, retrieval uses keyword search only.
EMBEDDING_API_KEY=
# EMBEDDING_MODEL=voyage-4
# Voyage's free tier (no payment method) allows 3 requests and 10K tokens a minute.
# There, embed in small paced batches (about 6K tokens a minute); filings stay
# searchable by keyword meanwhile.
# EMBEDDING_BATCH_SIZE=6
# EMBEDDING_REQUEST_INTERVAL=PT25S

# --- Google sign-in through Supabase Auth (optional) ---
# Project URL and publishable (or legacy anon) key from Supabase: Project Settings → API.
# Both are public. Without them only email and password sign-in is offered.
# For `npm run dev`, also set them as NEXT_PUBLIC_SUPABASE_URL and
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY in frontend/.env.local.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# --- Application ---
# Browser-facing URL, used to build links in emails.
APP_PUBLIC_URL=http://localhost:3000

# --- Monitoring of watched companies ---
# Each watched company's filing list is re-read from SEC once per interval (ISO-8601 duration).
MONITORING_ENABLED=true
MONITORING_POLL_INTERVAL=PT15M

# --- Email (Mailpit is used in local development; UI at http://localhost:8025) ---
MAIL_FROM="FilingLens <no-reply@localhost>"
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
# true for providers that require an encrypted connection (Gmail: smtp.gmail.com, port 587).
SMTP_STARTTLS=false
# Gmail: SMTP_USERNAME is your address, SMTP_PASSWORD a 16-character app password
# (https://myaccount.google.com/apppasswords, needs 2-Step Verification), and
# MAIL_FROM must use the same address, e.g. "FilingLens <you@gmail.com>".
