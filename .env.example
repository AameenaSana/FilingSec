# Copy to .env and fill in. .env is gitignored — never commit real values.

# --- Database ---
POSTGRES_DB=filinglens
POSTGRES_USER=filinglens
POSTGRES_PASSWORD=change-me

# --- SEC EDGAR ---
# SEC requires a declared User-Agent identifying you and a contact email.
# See https://www.sec.gov/os/accessing-edgar-data
SEC_USER_AGENT="FilingLens your-email@example.com"

# --- AI providers ---
# Anthropic API key for answering questions (Claude). Without it, Q&A is disabled.
LLM_API_KEY=
# LLM_MODEL=claude-opus-5-5
# Voyage AI key for semantic search. Without it, retrieval uses keyword search only.
EMBEDDING_API_KEY=
# EMBEDDING_MODEL=voyage-4

# --- Google sign-in through Supabase Auth (optional) ---
# Project URL and publishable (or legacy anon) key from Supabase: Project Settings → API.
# Both are public. Without them only email and password sign-in is offered.
# For `npm run dev`, also set them as NEXT_PUBLIC_SUPABASE_URL and
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY in frontend/.env.local.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# --- Application ---
# Browser-facing URL, used to build links in emails.
APP_PUBLIC_URL=http://localhost:3000

# --- Monitoring of watched companies ---
# Each watched company's filing list is re-read from SEC once per interval (ISO-8601 duration).
MONITORING_ENABLED=true
MONITORING_POLL_INTERVAL=PT15M

# --- Email (Mailpit is used in local development; UI at http://localhost:8025) ---
MAIL_FROM="FilingLens <no-reply@localhost>"
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
