# Copy to .env and fill in. .env is gitignored — never commit real values.

# --- Database ---
POSTGRES_DB=filinglens
POSTGRES_USER=filinglens
POSTGRES_PASSWORD=change-me

# --- SEC EDGAR ---
# SEC requires a declared User-Agent identifying you and a contact email.
# See https://www.sec.gov/os/accessing-edgar-data
SEC_USER_AGENT="FilingLens your-email@example.com"

# --- AI providers (used from Phase 6 onward) ---
LLM_API_KEY=
EMBEDDING_API_KEY=

# --- Email (Mailpit is used in local development) ---
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
